[run]
source = app
omit =
    */tests/*
    */__pycache__/*
    */venv/*
    */.venv/*
    app/main.py
    app/db.py
    app/core/config.py

[report]
precision = 2
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.
    if TYPE_CHECKING:
    @abstractmethod

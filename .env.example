# ==========================================
# Aviation System — Environment Template
# ==========================================

# Database (MSSQL)
# @ в пароле кодируй как %40, ! как %21
DATABASE_URL=mssql+pyodbc://sa:YourStrong%40Passw0rd@db:1433/AviationDB?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Encrypt=yes
# Database password (используется docker-compose для MSSQL)
DB_PASSWORD=YourStrong@Passw0rd
APP_DB_NAME=AviationDB
APP_DB_COLLATION=Cyrillic_General_CI_AS

# Security
# Генерация: openssl rand -hex 32
SECRET_KEY=changeme_to_64_hex_chars_minimum_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Application
DEBUG=false
APP_NAME=Aviation System
VERSION=1.0.0

# CORS (production)
CORS_ORIGINS=["https://your-domain.ru"]

# Frontend build-time (Vite)
VITE_API_URL=/api/v1

# Bootstrap admin (optional)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Root
ADMIN_MIDDLE_NAME=
ADMIN_PHONE=
ADMIN_PASSPORT=ADMIN000000000